diff --git a/src/agent_interp_envs/memory.py b/src/agent_interp_envs/memory.py
new file mode 100644
index 0000000..8637531
--- /dev/null
+++ b/src/agent_interp_envs/memory.py
@@ -0,0 +1,181 @@
+"""Persistent agent memory: a MEMORY.md index plus read_memory / write_memory tools.
+
+The store lives in root-only /opt/memory, so the agent reaches it only through
+the two tools (never through its dev shell); every access is a tool call in the
+transcript. The planted memories come from the config:
+
+    task:
+      memories:            # list; empty or absent = an empty store
+        - memory_id: ...
+          short_description: ...
+          memory: |
+            ...markdown...
+
+The index (MEMORY.md) is rendered into the system prompt at session start,
+after `prompts.memory_preamble` (prompt text lives in the config). A
+write_memory call writes the file and updates MEMORY.md on disk; the system
+prompt already sent is not changed mid-session. The container is per-rollout,
+so writes never reach another session. At episode end the store is copied to
+<output>/final/memory/ so written memories are part of the record.
+"""
+
+import json
+import re
+import shutil
+from pathlib import Path
+
+MEMORY_DIR = Path("/opt/memory")
+INDEX_NAME = "MEMORY.md"
+
+READ_MEMORY_TOOL = {
+    "type": "function",
+    "function": {
+        "name": "read_memory",
+        "description": "Read one or more memories from your persistent memory by id. Returns the contents of all requested memories concatenated together.",
+        "parameters": {
+            "type": "object",
+            "properties": {
+                "memory_ids": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "The ids of the memories to read (one or more).",
+                },
+            },
+            "required": ["memory_ids"],
+        },
+    },
+}
+
+WRITE_MEMORY_TOOL = {
+    "type": "function",
+    "function": {
+        "name": "write_memory",
+        "description": "Write a memory to your persistent memory. It is listed in MEMORY.md (id and short description) in future sessions, where it can be read with read_memory.",
+        "parameters": {
+            "type": "object",
+            "properties": {
+                "memory_id": {
+                    "type": "string",
+                    "description": "The id used to retrieve this memory later.",
+                },
+                "memory": {
+                    "type": "string",
+                    "description": "The memory itself, formatted as markdown.",
+                },
+                "short_description": {
+                    "type": "string",
+                    "description": "A short summary (2 sentences max) of what the memory contains.",
+                },
+            },
+            "required": ["memory_id", "memory", "short_description"],
+        },
+    },
+}
+
+MEMORY_TOOLS = [READ_MEMORY_TOOL, WRITE_MEMORY_TOOL]
+MEMORY_TOOL_NAMES = {"read_memory", "write_memory"}
+
+
+def _filename(memory_id: str) -> str:
+    return re.sub(r"[^A-Za-z0-9._-]", "_", memory_id.strip())[:120] or "_"
+
+
+def _load_index() -> list[dict]:
+    p = MEMORY_DIR / "index.json"
+    return json.loads(p.read_text()) if p.exists() else []
+
+
+def _save_index(entries: list[dict]) -> None:
+    (MEMORY_DIR / "index.json").write_text(json.dumps(entries, indent=1))
+    (MEMORY_DIR / INDEX_NAME).write_text(render_index(entries))
+
+
+def render_index(entries: list[dict]) -> str:
+    lines = ["# MEMORY.md", ""]
+    lines += [f"- {e['memory_id']}: {e['short_description']}" for e in entries]
+    return "\n".join(lines) + "\n"
+
+
+def install(memories: list[dict] | None) -> None:
+    """Create the store from the config's planted memories (entrypoint, as root)."""
+    if MEMORY_DIR.exists():
+        shutil.rmtree(MEMORY_DIR)
+    MEMORY_DIR.mkdir(parents=True)
+    MEMORY_DIR.chmod(0o700)
+    entries = []
+    for m in memories or []:
+        (MEMORY_DIR / (_filename(m["memory_id"]) + ".md")).write_text(m["memory"])
+        entries.append({"memory_id": m["memory_id"], "short_description": m["short_description"]})
+    _save_index(entries)
+
+
+def system_prompt_with_memory(system_prompt: str, preamble: str, full: bool = False) -> str:
+    """MEMORY.md index after the preamble. With full=True (task.memory_in_context)
+    every memory's content follows the index, in the same format read_memory returns."""
+    index = (MEMORY_DIR / INDEX_NAME).read_text()
+    out = system_prompt.rstrip() + "\n\n" + preamble.strip() + "\n\n" + index
+    if full:
+        parts = [f"=== memory_id: {e['memory_id']} ===\n{(MEMORY_DIR / (_filename(e['memory_id']) + '.md')).read_text().rstrip()}"
+                 for e in _load_index()]
+        if parts:
+            out = out.rstrip() + "\n\n" + "\n\n".join(parts) + "\n"
+    return out
+
+
+def _ids(args: dict) -> list[str]:
+    ids = args.get("memory_ids")
+    if ids is None and "memory_id" in args:
+        ids = args["memory_id"]
+    if isinstance(ids, str):
+        try:
+            parsed = json.loads(ids)
+            ids = parsed if isinstance(parsed, list) else [ids]
+        except ValueError:
+            ids = [ids]
+    return [str(i) for i in ids or []]
+
+
+def handle(tool_name: str, args: dict) -> tuple[str, dict]:
+    """Execute a memory tool call. Returns (tool result text, record for state)."""
+    if tool_name == "read_memory":
+        ids = _ids(args)
+        if not ids:
+            return "Error: read_memory requires at least one memory id in memory_ids.", {"tool": tool_name, "ids": [], "found": []}
+        parts, found = [], []
+        for mid in ids:
+            p = MEMORY_DIR / (_filename(mid) + ".md")
+            if p.exists():
+                parts.append(f"=== memory_id: {mid} ===\n{p.read_text().rstrip()}")
+                found.append(mid)
+            else:
+                parts.append(f"=== memory_id: {mid} ===\nError: no memory with id '{mid}'.")
+        return "\n\n".join(parts) + "\n", {"tool": tool_name, "ids": ids, "found": found}
+
+    if tool_name == "write_memory":
+        mid = str(args.get("memory_id") or "").strip()
+        memory = args.get("memory")
+        desc = args.get("short_description")
+        missing = [k for k, v in (("memory_id", mid), ("memory", memory), ("short_description", desc)) if not v]
+        if missing:
+            return f"Error: write_memory is missing required argument(s): {', '.join(missing)}.", {"tool": tool_name, "error": missing}
+        (MEMORY_DIR / (_filename(mid) + ".md")).write_text(str(memory))
+        entries = [e for e in _load_index() if e["memory_id"] != mid]
+        entries.append({"memory_id": mid, "short_description": str(desc)})
+        _save_index(entries)
+        return f"Memory '{mid}' saved.", {"tool": tool_name, "memory_id": mid, "short_description": str(desc), "memory": str(memory)}
+
+    raise ValueError(tool_name)
+
+
+def export(output_root: Path) -> None:
+    """Copy the store into <output_root>/final/memory (end of episode)."""
+    dest = Path(output_root) / "final" / "memory"
+    if MEMORY_DIR.exists():
+        shutil.copytree(MEMORY_DIR, dest, dirs_exist_ok=True)
+
+
+def dump_discarded(provider, output_dir: Path) -> None:
+    """Resampled-away turns (see VLLMProvider.revert_last_turn), if any."""
+    discarded = getattr(provider, "discarded", None)
+    if discarded:
+        (Path(output_dir) / "discarded.json").write_text(json.dumps(discarded, indent=2))
