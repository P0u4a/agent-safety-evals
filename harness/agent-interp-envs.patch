diff --git a/src/agent_interp_envs/providers/vllm_provider.py b/src/agent_interp_envs/providers/vllm_provider.py
new file mode 100644
index 0000000..909e49e
--- /dev/null
+++ b/src/agent_interp_envs/providers/vllm_provider.py
@@ -0,0 +1,217 @@
+"""Self-hosted model behind a vLLM OpenAI-compatible server (chat completions).
+
+The server URL comes from VLLM_BASE_URL (e.g. http://host.docker.internal:8000/v1).
+Requests are streamed so a long thinking turn never sits on an idle connection
+(the server is reached through an SSH tunnel), and the stream is reassembled
+here into one assistant message.
+
+Every assistant message keeps, next to the standard chat fields:
+  reasoning_content  the model's thinking (vLLM reasoning parser output)
+  finish_reason      "stop" / "tool_calls" / "length" ("length" = hit max_tokens: truncated)
+  usage              prompt/completion token counts for the turn
+Those extras are stripped from the history sent back to the server, except
+reasoning_content, which is handed to the chat template (the template decides
+whether past thinking is rendered).
+"""
+
+import json
+import os
+import time
+
+
+from openai import APIConnectionError, APIStatusError, APITimeoutError, OpenAI
+
+from agent_interp_envs.print_helpers import print_section, print_step_header
+from agent_interp_envs.providers.base import BaseProvider
+from agent_interp_envs.types import LLMResponse, ToolCall, ToolResult
+
+_SEND_KEYS = ("role", "content", "tool_calls", "tool_call_id", "name", "reasoning_content")
+
+
+class VLLMProvider(BaseProvider):
+    def __init__(
+        self,
+        model: str,
+        messages: list[dict],
+        tools: list[dict],
+        temperature: float | None = None,
+        top_p: float | None = None,
+        max_tokens: int | None = None,
+    ) -> None:
+        base_url = os.environ.get("VLLM_BASE_URL", "http://host.docker.internal:8000/v1")
+        self.client = OpenAI(base_url=base_url, api_key=os.environ.get("VLLM_API_KEY", "EMPTY"),
+                             # Non-streaming by default: llama-server re-parses the whole partial
+                             # message on every streamed token (quadratic in output length), which
+                             # made the CPU-bound server several times slower. VLLM_STREAM=1 restores
+                             # streaming. A dead tunnel resets the connection, so it still errors fast.
+                             timeout=float(os.environ.get("VLLM_TIMEOUT", "14400")), max_retries=0)
+        self.stream = os.environ.get("VLLM_STREAM", "0") == "1"
+        self.model = model
+        self.messages = messages
+        self.discarded: list[dict] = []
+        self.kwargs: dict = {}
+        if tools:
+            self.kwargs["tools"] = tools
+            self.kwargs["parallel_tool_calls"] = False
+        if temperature is not None:
+            self.kwargs["temperature"] = temperature
+        if top_p is not None:
+            self.kwargs["top_p"] = top_p
+        if max_tokens is not None:
+            self.kwargs["max_tokens"] = max_tokens
+
+    def _wire_messages(self) -> list[dict]:
+        out = []
+        for m in self.messages:
+            w = {k: m[k] for k in _SEND_KEYS if k in m and m[k] is not None}
+            if w.get("role") == "assistant" and "content" not in w:
+                w["content"] = ""
+            out.append(w)
+        return out
+
+    def _complete_once(self) -> dict:
+        resp = self.client.chat.completions.create(model=self.model, messages=self._wire_messages(), **self.kwargs)
+        choice = resp.choices[0]
+        msg = choice.message
+        extra = msg.model_extra or {}
+        tool_calls = [{"id": tc.id or f"call_{int(time.time() * 1000)}_{i}", "type": "function",
+                       "function": {"name": tc.function.name, "arguments": tc.function.arguments}}
+                      for i, tc in enumerate(msg.tool_calls or [])]
+        return {
+            "role": "assistant",
+            "content": msg.content or None,
+            "reasoning_content": extra.get("reasoning_content") or extra.get("reasoning") or None,
+            "tool_calls": tool_calls or None,
+            "finish_reason": choice.finish_reason,
+            "usage": resp.usage.model_dump() if resp.usage else None,
+        }
+
+    def _stream_once(self) -> dict:
+        stream = self.client.chat.completions.create(
+            model=self.model,
+            messages=self._wire_messages(),
+            stream=True,
+            stream_options={"include_usage": True},
+            **self.kwargs,
+        )
+        content: list[str] = []
+        reasoning: list[str] = []
+        calls: dict[int, dict] = {}
+        finish_reason = None
+        usage = None
+        for chunk in stream:
+            if chunk.usage is not None:
+                usage = chunk.usage.model_dump()
+            if not chunk.choices:
+                continue
+            choice = chunk.choices[0]
+            if choice.finish_reason:
+                finish_reason = choice.finish_reason
+            delta = choice.delta
+            if delta is None:
+                continue
+            extra = delta.model_extra or {}
+            r = extra.get("reasoning_content") or extra.get("reasoning")
+            if r:
+                reasoning.append(r)
+            if delta.content:
+                content.append(delta.content)
+            for tc in delta.tool_calls or []:
+                slot = calls.setdefault(tc.index, {"id": None, "type": "function",
+                                                   "function": {"name": "", "arguments": ""}})
+                if tc.id:
+                    slot["id"] = tc.id
+                if tc.function is not None:
+                    if tc.function.name:
+                        slot["function"]["name"] += tc.function.name
+                    if tc.function.arguments:
+                        slot["function"]["arguments"] += tc.function.arguments
+        tool_calls = []
+        for i in sorted(calls):
+            slot = calls[i]
+            if not slot["id"]:
+                slot["id"] = f"call_{int(time.time() * 1000)}_{i}"
+            tool_calls.append(slot)
+        message = {
+            "role": "assistant",
+            "content": "".join(content) or None,
+            "reasoning_content": "".join(reasoning) or None,
+            "tool_calls": tool_calls or None,
+            "finish_reason": finish_reason,
+            "usage": usage,
+        }
+        return message
+
+    def invoke(self) -> LLMResponse:
+        # Transient failures (server unreachable: tunnel or network down, 5xx) are
+        # retried for up to RETRY_WINDOW seconds, so an outage pauses the episode
+        # instead of failing it. A turn cut off mid-stream is re-sampled from scratch.
+        delay = 5
+        deadline = time.time() + int(os.environ.get("VLLM_RETRY_WINDOW", "7200"))
+        attempt = 0
+        while True:
+            attempt += 1
+            try:
+                message = self._stream_once() if self.stream else self._complete_once()
+                break
+            except APIStatusError as e:
+                # 4xx (bad request, context overflow) is not transient: surface it.
+                if e.status_code < 500 or time.time() > deadline:
+                    raise
+            except (APIConnectionError, APITimeoutError):
+                if time.time() > deadline:
+                    raise
+            print(f"[provider-retry] attempt {attempt} failed; sleeping {delay}s", flush=True)
+            time.sleep(delay)
+            delay = min(delay * 2, 120)
+        self.messages.append(message)
+        if message["finish_reason"] == "length":
+            print("[truncated] generation hit max_tokens (finish_reason=length)", flush=True)
+        tool_calls = [
+            ToolCall(id=tc["id"], name=tc["function"]["name"], arguments=tc["function"]["arguments"])
+            for tc in message.get("tool_calls") or []
+        ]
+        return LLMResponse(
+            reasoning=message.get("reasoning_content"),
+            response=message.get("content"),
+            tool_calls=tool_calls,
+        )
+
+    def add_tool_result(self, tool_result: ToolResult) -> None:
+        self.messages.append({"role": "tool", "tool_call_id": tool_result.id, "content": tool_result.content})
+
